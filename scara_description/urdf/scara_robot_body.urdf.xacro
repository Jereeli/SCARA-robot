<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="body">
    <xacro:macro name="body" params="cylinder_radius cylinder3_radius cylinder1_length 
    cylinder2_length cylinder3_length cylinder4_length base_heigth base_width
    box1_length box2_length box1_width box2_width
    box1_heigth box2_heigth">

        <link name="base_link">
            <visual>
                <origin xyz="0 0 ${base_heigth/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${base_width} ${base_width} ${base_heigth}"/>
                </geometry>
                <material name="harmaa">
                    <color rgba="0.3 0.3 0.3 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="world_to_base" type="fixed">
            <parent link="world"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <child link="base_link"/>
        </joint>

        <link name="link1">
            <visual>
                <origin xyz="0 0 ${cylinder1_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${cylinder_radius}" length="${cylinder1_length}"/>
                </geometry>
                <material name="valkoinen">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
        </link>

        <joint name="base_to_link1" type="revolute">
            <parent link="base_link"/>
            <origin xyz="0 0 ${base_heigth}" rpy="0 0 0"/>
            <child link="link1"/>
            <axis xyz="0 0 1"/>
            <limit effort="10" lower="-3.14" upper="3.14" velocity="1"/>
        </joint>

        <link name="link2">
            <visual>
                <origin xyz="0 ${box1_length/2} ${box1_heigth/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${box1_width} ${box1_length} ${box1_heigth}"/>
                </geometry>
                <material name="harmaa">
                    <color rgba="0.3 0.3 0.3 1"/>
                </material>
            </visual>
        </link>

        <joint name="link1_to_link2" type="fixed">
            <parent link="link1"/>
            <child link="link2"/>
            <origin xyz="0 0 ${cylinder1_length - box1_heigth}"/>
        </joint>

        <link name="link3">
            <visual>
                <origin xyz="0 0 ${cylinder2_length/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${cylinder_radius}" length="${cylinder2_length}"/>
                </geometry>
                <material name="valkoinen">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
        </link>

        <joint name="link2_to_link3" type="revolute">
            <parent link="link2"/>
            <child link="link3"/>
            <origin xyz="0 ${box1_length} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="10" lower="-3.14" upper="3.14" velocity="1"/>
        </joint>

        <link name="link4">
            <visual>
                <origin xyz="0 ${box2_length/2} ${box2_heigth/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${box2_width} ${box2_length} ${box2_heigth}"/>
                </geometry>
                <material name="harmaa">
                    <color rgba="0.3 0.3 0.3 1"/>
                </material>
            </visual>
        </link>

        <joint name="link3_to_link4" type="fixed">
            <parent link="link3"/>
            <child link="link4"/>
            <origin xyz="0 0 ${cylinder2_length - box2_heigth}"/>
        </joint>

        <link name="link5">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${cylinder3_radius}" length="${cylinder3_length}"/>
                </geometry>
                <material name="valkoinen">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
        </link>

        <joint name="link4_to_link5" type="revolute">
            <parent link="link4"/>
            <child link="link5"/>
            <origin xyz="0 ${box2_length} ${box2_heigth/2}"/>
            <axis xyz="0 0 1"/>
            <limit effort="10" lower="-3.14" upper="3.14" velocity="1"/>
        </joint>

        <link name="link6">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.05" length="${cylinder4_length}"/>
                </geometry>
                <material name="harmaa">
                    <color rgba="0.3 0.3 0.3 1"/>
                </material> 
            </visual>
        </link>

        <joint name="link5_to_link6" type="prismatic">
            <parent link="link5"/>
            <child link="link6"/>
            <origin xyz="0 0 0"/>
            <limit effort="150.0" lower="-0.23" upper="0.065" velocity="0.5"/>
            <axis xyz="0 0 1"/>
        </joint>

    </xacro:macro>

</robot>