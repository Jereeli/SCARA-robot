<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gripper">

    <xacro:macro name="finger" params="prefix length width thickness">
        <link name="${prefix}_finger">
            <visual>
            <origin xyz="0 0 ${-length/2}"/>
            <geometry>
                <box size="${thickness} ${width} ${length}"/>
            </geometry>
            <material name="harmaa">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
            </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="gripper" params="space box_length box_width box_heigth">
        <joint name="link6_to_gripper" type="fixed">
            <origin xyz="0 0 ${-cylinder4_length/2}" rpy="0 0 0"/>
            <parent link="link6"/>
            <child link="gripper_box"/>
        </joint>

        <link name="gripper_box">
            <visual>
            <origin xyz="0 0 ${-box_heigth/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${box_width} ${box_length} ${box_heigth}"/>
            </geometry>
            <material name="valkoinen">
                <color rgba="1 1 1 1"/>
            </material>
            </visual>
        </link>

        <xacro:finger prefix="1" width="0.08" thickness="0.03" length="0.14"/>
        <xacro:finger prefix="2" width="0.08" thickness="0.03" length="0.14"/>

        <joint name="gripper_to_finger1" type="fixed">
            <origin xyz="${space} 0 ${-box_heigth}"/>
            <parent link="gripper_box"/>
            <child link="1_finger"/> 
        </joint>

        <joint name="gripper_to_finger2" type="fixed">
            <origin xyz="${-space} 0 ${-box_heigth}"/>
            <parent link="gripper_box"/>
            <child link="2_finger"/> 
        </joint>

        <link name="TCP"/>

        <joint name="gripper_to_TCP" type="fixed">
            <parent link="gripper_box"/>
            <child link="TCP"/>
            <origin xyz="0 0 ${-(box_heigth + 0.07)}" rpy="0 0 0"/>
        </joint>

    </xacro:macro>

</robot>